<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- One test at a time. Use it as the baseline for timing, and with -Drecord.video=true:
     the recorder films the whole desktop, so parallel runs would mix up the videos. -->
<suite name="Swag Labs UI (sequential)" verbose="1">

    <listeners>
        <listener class-name="com.swaglabs.listeners.ResultListener"/>
    </listeners>

    <test name="Authentication">
        <classes>
            <class name="com.swaglabs.tests.auth.LoginTests"/>
        </classes>
    </test>

    <test name="Shopping">
        <classes>
            <class name="com.swaglabs.tests.shopping.InventoryTests"/>
            <class name="com.swaglabs.tests.shopping.ProductDetailsTests"/>
            <class name="com.swaglabs.tests.shopping.CartTests"/>
        </classes>
    </test>

    <test name="Checkout">
        <classes>
            <class name="com.swaglabs.tests.checkout.CheckoutInfoTests"/>
            <class name="com.swaglabs.tests.checkout.CheckoutOverviewTests"/>
            <class name="com.swaglabs.tests.checkout.OrderCompleteTests"/>
        </classes>
    </test>

</suite>
